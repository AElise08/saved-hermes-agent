#!/bin/sh
# Drain the Saved outbox every five minutes, including the Sunday weekly digest.
#
# Hermes cron matches in UTC, not the container TZ, so the weekly send lives
# here: drain() itself checks Sunday 14:00–14:09 local time.
#
# /opt/saved, never $HERMES_HOME/scripts. The home copy belongs to uid 10000
# in a running container; scheduling it would run whatever a turn last wrote.
set -eu

PATH=/command:/usr/local/bin:/usr/local/sbin:/usr/bin:/usr/sbin:/bin:/sbin
export PATH

TZ=$(cat /run/s6/container_environment/TZ 2>/dev/null || true)
[ -n "$TZ" ] || TZ=UTC
export TZ
export HERMES_HOME=/var/lib/hermes
export PYTHONPATH=/opt/saved/scripts

while :; do
  /command/s6-setuidgid hermes \
    env HOME="$HERMES_HOME" HERMES_HOME="$HERMES_HOME" TZ="$TZ" PYTHONPATH="$PYTHONPATH" \
    /opt/hermes/.venv/bin/python3 /opt/saved/scripts/outbox.py drain \
    || echo "saved-outbox: drain exited non-zero; retrying at the next tick" >&2
  /bin/sleep 300
done
